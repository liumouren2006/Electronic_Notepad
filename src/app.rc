#include <windows.h>

IDI_ICON1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "MoJi"
            VALUE "FileDescription", "MoJi Electronic Notebook"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "moji"
            VALUE "OriginalFilename", "moji-gui.exe"
            VALUE "ProductName", "MoJi"
            VALUE "ProductVersion", "1.0.0"
            VALUE "LegalCopyright", "Course project"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
